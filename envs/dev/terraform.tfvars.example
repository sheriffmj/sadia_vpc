#this is not the real terraform.tfvars file, the eeal one has been added to gitignore to avoid making some personal info public. Besides the place holders in here, this is identical.

aws_region                = "us-east-1"
environment               = "dev"
owner                     = "your-name" #placeholder
project_name              = "sadia"
availability_zone_count   = 3
vpc_cidr                  = "10.0.0.0/16"
inbound_web_cidr          = ["0.0.0.0/0"]
admin_cidrs               = ["203.0.113.5/32"] #placeholder
admin_principal_arn       = "arn:aws:iam::<account-id>:user/<your-user>" #placeholder
kubernetes_version        = "<supported version>"
instance_type             = "m5.xlarge"
desired_size              = 9
min_size                  = 9
max_size                  = 12
nodes_ami_type            = "AL2023_x86_64_STANDARD"
retention_in_days         = 90
enabled_cluster_log_types = ["api", "audit", "authenticator", "controllerManager", "scheduler"]
